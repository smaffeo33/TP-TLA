trigger('groupOfGroups', [
  transition('* => *', [
    group([
      group([
        style({ opacity: 0 }),
        animate('100ms', style({ opacity: 0.3 }))
      ]),
      group([
        animate('200ms', style({ opacity: 0.6 })),
        animate('200ms', style({ opacity: 1 }))
      ])
    ])
  ])
])