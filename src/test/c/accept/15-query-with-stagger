trigger('listStagger', [
  transition('* <=> *', [
    query(':enter', [
      style({ opacity: 0, transform: 'translateY(20px)' }),
      stagger('100ms', [
        animate('300ms ease-out', style({ opacity: 1, transform: 'translateY(0px)' }))
      ])
    ])
  ]),
  transition(':enter', [
      /* ← here you can call query()… */
      query('.item', [
        style({ opacity: 0 }),
        animate('300ms', style({ opacity: 1 }))
      ]),

      /* …and you can also nest it inside a group/sequence/stagger: */
      group([
        sequence([
          query('.foo', [ animate('200ms', style({ transform:'scaleX(1)' })) ]),
          query('.bar', [ animate('200ms', style({ transform:'scaleX(0.5)' })), stagger('50ms', [ query('.baz', [ animate('100ms', style({ opacity:0.5 })) ]) ]) ])
        ])
      ])
    ])
])