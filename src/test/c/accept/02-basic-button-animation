trigger('buttonAnimation', [
state('normal', style({
backgroundColor: '#3498db',
transform: 'scale(1)',
borderRadius: '4px',
color: 'white'
})),
state('hovered', style({
backgroundColor: '#2980b9',
transform: 'scale(1.05)',
borderRadius: '4px',
color: 'white'
})),
state('pressed', style({
backgroundColor: '#1c6ea4',
transform: 'scale(0.98)',
borderRadius: '4px',
color: 'white'
})),
transition('normal => hovered', animate('150ms ease-out')),
transition('hovered => pressed', animate('100ms ease-in')),
transition('pressed => normal', animate('200ms ease-in-out'))
])